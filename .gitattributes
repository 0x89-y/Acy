# Store and check out text as LF everywhere (overrides core.autocrlf), so
# editors/tools writing LF on Windows don't show every file as modified.
* text=auto eol=lf

# cmd.exe needs CRLF in batch files (labels/goto misbehave with LF).
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets
*.png binary
*.ico binary
*.icns binary
