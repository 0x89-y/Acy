{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Acy",
  "version": "0.9.1",
  "identifier": "acy",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Acy",
        "width": 1120,
        "height": 760,
        "minWidth": 880,
        "minHeight": 600,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/0x89-y/Acy/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYwMzBDOTI3M0E0MzU0QjcKUldTM1ZFTTZKOGt3WUErMmNKZ3NiYVIxbGxHd2krZjEwc1JDWFpVNHc5U3JQNDd3KzlqZTlTQm8K"
    }
  }
}
